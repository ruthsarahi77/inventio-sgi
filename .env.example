# Plantilla de referencia: Spring Boot NO carga .env automaticamente.
# Exportar estas variables en la terminal o configurarlas en el IDE.
DB_URL=jdbc:postgresql://<HOST-DEL-SESSION-POOLER>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<PROJECT-ID>
DB_PASSWORD=<DATABASE-PASSWORD>
# Opcional: logging SQL para desarrollo
SPRING_PROFILES_ACTIVE=dev

# JWT propio de Inventio; Base64 de al menos 32 bytes aleatorios, sin valor por defecto.
JWT_SECRET=<BASE64-DE-CLAVE-ALEATORIA>
JWT_ISSUER=inventio-api
JWT_AUDIENCE=inventio-clients
JWT_TTL_SECONDS=900
# Origenes web exactos separados por coma; React Native no necesita CORS.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Opcionales: si falta alguna, no se crea el ADMIN. Nunca se modifica un email existente.
INITIAL_ADMIN_NAME=Administrador
INITIAL_ADMIN_EMAIL=<EMAIL-ADMIN>
INITIAL_ADMIN_PASSWORD=<PASSWORD-ADMIN>

# Recuperacion de contrasena: Resend SMTP con TLS implicito (465).
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=<API_KEY_RESEND>
MAIL_FROM=onboarding@resend.dev
# Mantener la URL de recuperacion existente en el entorno. No sustituirla por el placeholder.
FRONTEND_RESET_PASSWORD_URL=<URL_EXISTENTE>
PASSWORD_RESET_TTL_MINUTES=20
# Estas tres variables son necesarias: application.properties conserva defaults para STARTTLS/587.
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=false
MAIL_STARTTLS_REQUIRED=false
MAIL_SSL_ENABLE=true
